# Copy to .env and fill in. Loaded by the Pydantic Settings class (§12.3).
# Never read with os.getenv inline.

DATABASE_URL=postgresql+psycopg://fces:fces@localhost:5433/fces
JWT_SECRET=change-me-in-production
# Groq, for the language model tier (openai/gpt-oss-120b). Free tier; never committed.
# fcesreg reads this one variable through a single accessor in llm.py — see §12.3.
GROQ_API_KEY=
# Leave unset: the default is anchored to the repo root (fcesapi.config._repo_root()).
# Setting this to a relative path (e.g. "./storage") reintroduces a cwd-dependent cache
# miss -- measured once already, see test_config.py. Set it only to an ABSOLUTE path.
# STORAGE_ROOT=
BASE_URL=http://localhost:3000

# Passwords only -- seed_users.py (§7.1) hardcodes the three seed addresses
# (admin@fces.internal etc). There is no user administration UI.
SEED_ADMIN_PASSWORD=
SEED_TECHNICIAN_PASSWORD=
SEED_READONLY_PASSWORD=
