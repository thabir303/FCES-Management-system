# Copy to .env and fill in. Loaded by the Pydantic Settings class (§12.3).
# Never read with os.getenv inline.

DATABASE_URL=postgresql+psycopg://fces:fces@localhost:5433/fces
JWT_SECRET=change-me-in-production
# Groq, for the language model tier (openai/gpt-oss-120b). Free tier; never committed.
# fcesreg reads this one variable through a single accessor in llm.py — see §12.3.
GROQ_API_KEY=
STORAGE_ROOT=./storage
BASE_URL=http://localhost:3000

# Seeded by scripts/seed_users.py (§7.1). There is no user administration UI.
SEED_ADMIN_EMAIL=admin@fces.local
SEED_ADMIN_PASSWORD=
SEED_TECHNICIAN_EMAIL=technician@fces.local
SEED_TECHNICIAN_PASSWORD=
SEED_READONLY_EMAIL=readonly@fces.local
SEED_READONLY_PASSWORD=
